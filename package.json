{
  "name": "claude-design-comments-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome 擴充功能：把 Claude Design 專案匯出成官方 zip 加上留言（comments.json / comments.md），並在留言關聯的元素標上 data-comment-id。",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": "9.15.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "sh scripts/package.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "css-select": "7.0.0",
    "domutils": "4.0.2",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "domhandler": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.2.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.29.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
